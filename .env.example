# Copy to .env for local use. Never commit .env or real credentials.
A_SHARE_QUANT_ENVIRONMENT=development
A_SHARE_QUANT_PROVIDER=akshare
A_SHARE_QUANT_DATA_DIR=data
A_SHARE_QUANT_DATABASE_PATH=quant.duckdb
A_SHARE_QUANT_LOG_LEVEL=INFO
A_SHARE_QUANT_REQUEST_TIMEOUT_SECONDS=30
A_SHARE_QUANT_REQUEST_RETRY_COUNT=3
A_SHARE_QUANT_REQUEST_DELAY_SECONDS=0.25

# Optional provider credentials. Leave empty for the free AKShare path.
TUSHARE_TOKEN=
RQDATA_CONFIG_PATH=

# V1 safety boundary: paper/no-op only.
A_SHARE_QUANT_EXECUTION_MODE=paper
A_SHARE_QUANT_ALLOW_LIVE=false
